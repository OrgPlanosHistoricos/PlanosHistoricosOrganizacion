MONGODB_URI=
SUPABASE_URL=
SUPABASE_KEY=

# Postgres del docker-compose (valores de desarrollo; cambiarlos al deployar)
POSTGRES_USER=planos
POSTGRES_PASSWORD=planos
POSTGRES_DB=planos_db
DATABASE_URL=postgresql://planos:planos@localhost:5432/planos_db

# MinIO (almacenamiento local de planos y previsualizaciones)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=planos
MINIO_SECURE=false

# Ollama remoto en Google Colab vía túnel de Ngrok (ej: OLLAMA_HOST=https://xxxx.ngrok-free.app)
# El modelo activo se elige directamente desde el notebook ollama_colab.ipynb en Google Colab (alias colab-activo).
# VISION_MODEL actúa solo como fallback si ejecutás Ollama localmente.
OLLAMA_HOST=https://xxxx.ngrok-free.app
# VISION_MODEL=qwen2.5vl:3b
