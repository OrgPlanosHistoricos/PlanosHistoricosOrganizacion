# Supabase: Storage (archivos de los planos y previsualizaciones)
SUPABASE_URL=https://<proyecto>.supabase.co
# service_role key (Settings → API); el bucket tiene RLS y la anon no puede subir
SUPABASE_KEY=
SUPABASE_BUCKET=planos_escaneados

# Supabase: Postgres (Connect → Connection string → URI → Session pooler)
SUPABASE_DB_URL=postgresql://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Localidad (código de tramitacion.localidades) de los inmuebles a los que se vinculan los planos
LOCALIDAD_PLANOS=LP

# Ollama remoto en Google Colab vía túnel de Ngrok (ej: OLLAMA_HOST=https://xxxx.ngrok-free.app)
# El modelo activo se elige directamente desde el notebook ollama_colab.ipynb en Google Colab (alias colab-activo).
# VISION_MODEL actúa solo como fallback si ejecutás Ollama localmente.
OLLAMA_HOST=https://xxxx.ngrok-free.app
# VISION_MODEL=qwen2.5vl:3b
